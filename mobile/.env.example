# API base URL the app talks to. EXPO_PUBLIC_* vars are embedded in the
# client bundle at build time (same convention as frontend/'s NEXT_PUBLIC_*)
# -- fine to commit, nothing secret here.
#
# This value is ONLY used by `expo start` (local dev, Metro live-bundling).
# `eas build` profiles (preview/production, see eas.json) set their own
# EXPO_PUBLIC_API_URL pointing at the real deployed api-dev/api hosts --
# a standalone build has no local dev server to reach anyway, and Android
# blocks plain HTTP outright regardless (see the CLEARTEXT error if this
# ever gets carried into a real build by mistake).
#
# "localhost" only reaches your dev machine's API from an iOS Simulator
# (it shares the host's network stack). It will NOT work from:
#   - an Android emulator -- use 10.0.2.2 instead (Android's alias for the
#     host machine's localhost), e.g. http://10.0.2.2:8001/api/v1
#   - a real physical device (Expo Go or a dev build) -- use your dev
#     machine's actual LAN IP, e.g. http://192.168.1.23:8001/api/v1
EXPO_PUBLIC_API_URL=http://localhost:8001/api/v1
