# 'frontend'/'api' are ambiguous on the shared caddy_net network — both the
# my-car and my-car-dev Compose projects run a service by that short name,
# and Compose registers the short name as a DNS alias on *every* network a
# service joins, including this external one. So Docker's embedded DNS
# round-robins between the two projects' containers for the same short
# name — confirmed live: `getent hosts api` from inside this container
# returned both my-car-api-1 and my-car-dev-api-1, alternating per query.
# That's what caused prod to intermittently serve dev's build/API and vice
# versa. Full container names (<project>-<service>-1) are what's actually
# unambiguous on caddy_net, so every route here uses one, not just dev's.
app.glavbox.com {
	reverse_proxy my-car-frontend-1:3000
}

api.glavbox.com {
	reverse_proxy my-car-api-1:8001
}

dev.glavbox.com {
	reverse_proxy my-car-dev-frontend-1:3000
}

api-dev.glavbox.com {
	reverse_proxy my-car-dev-api-1:8001
}
