# Copy to scripts/deploy-gke.env, fill in, then:  set -a; . scripts/deploy-gke.env; set +a; ./scripts/deploy-gke.sh
# NOTE: deploy-gke.env is gitignored — never commit real secrets.

# GCP project + resource names
PROJECT_ID=my-gcp-project-id
REGION=us-central1
REPO=mycar
CLUSTER=mycar-gke
PG=mycar-pg
REDIS=mycar-redis
NETWORK=default
IMAGE_TAG=latest

# App hostnames
APP_HOST=app.example.com
API_HOST=api.example.com

# Secrets
DB_PASSWORD=change-me-strong-db-password
DJANGO_SECRET_KEY=change-me-django-secret
ADMIN_EMAIL=admin@mycar.com
ADMIN_PASSWORD=change-me-admin-password
GOOGLE_OAUTH_CLIENT_ID=
TELEMETRYDECK_APP_ID=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=
# Server-side only (signs the account-purge sweep's photo cleanup calls) —
# separate from CLOUDINARY_CLOUD_NAME/UPLOAD_PRESET above, which are public
# and baked into the frontend build. Standard cloudinary://key:secret@
# cloud_name form (same as Cloudinary's own SDKs read). Leave blank to skip
# that cleanup step.
CLOUDINARY_URL=
NEW_RELIC_LICENSE_KEY=
