# ── Django ────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-in-production
DEBUG=True

# ── Super admin (seeded on boot) ──────────────────────────────────────────
ADMIN_EMAIL=admin@mycar.com
ADMIN_PASSWORD=change-me-admin-password

# ── Google OAuth ──────────────────────────────────────────────────────────
GOOGLE_OAUTH_CLIENT_ID=

# ── Email (console backend by default in dev) ─────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@mycar.com

OTP_EXPIRY_MINUTES=10

# ── AI assistant (Gemini) ───────────────────────────────────────────────────
# Google AI Studio API key — powers the in-app car assistant chat.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Per-user cap on assistant message sends (DRF throttle rate).
ASSISTANT_CHAT_THROTTLE=30/min

# ── Frontend ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
FRONTEND_URL=http://localhost:3000

# Cloudinary (car photo uploads — browser uploads directly to Cloudinary via
# an unsigned upload preset; the API never sees the file)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# TelemetryDeck (privacy-focused product analytics) — App ID from the
# TelemetryDeck dashboard. Leave blank to disable telemetry entirely.
NEXT_PUBLIC_TELEMETRYDECK_APP_ID=
