# Activates worker/beat, which docker-compose.yml gates behind the "full"
# profile — Compose skips profile-tagged services on `up`/`build` unless
# their profile is active. Set here so local `docker compose up --build`
# keeps including them by default; the droplet's dev stack (see #81)
# deliberately omits this in its own .env to run lighter (no async
# email/reminder features there, which is fine for QA/preview).
COMPOSE_PROFILES=full

# ── Django ────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-in-production
# True is fine locally. DEBUG now defaults to False in settings.py, so a
# deployed environment that forgets this variable fails closed.
DEBUG=True

# ── Super admin (seeded on boot) ──────────────────────────────────────────
# Leave ADMIN_PASSWORD blank and seed_admin generates a random one, printing
# it once on first boot. Set it explicitly only if you need a known value.
ADMIN_EMAIL=admin@mycar.com
ADMIN_PASSWORD=

# Number of proxies in front of the app, used to pick the real client IP out
# of X-Forwarded-For for rate limiting. Blank locally (no proxy); 1 behind
# Caddy on the droplet (see docker-compose.prod.yml), which sets a single
# "<client>" value in X-Forwarded-For.
NUM_PROXIES=

# docker-compose.yml's dev defaults work unset for local Compose. A real
# deployment (see docker-compose.prod.yml) must set both to the real
# domain(s), e.g.:
#   ALLOWED_HOSTS=app.example.com,api.example.com
#   CORS_ALLOWED_ORIGINS=https://app.example.com
ALLOWED_HOSTS=
CORS_ALLOWED_ORIGINS=

# Host-side port bindings — only matter when running a second stack
# alongside another one on the same machine (e.g. dev and prod side by side
# on the droplet, see #81). Unset uses docker-compose.yml's defaults
# (8001/3000/5434); the dev stack's .env sets these to something else so
# neither stack's `docker compose up` fails trying to bind a port the other
# stack already holds.
API_HOST_PORT=
FRONTEND_HOST_PORT=
DB_HOST_PORT=

# ── Google OAuth ──────────────────────────────────────────────────────────
GOOGLE_OAUTH_CLIENT_ID=

# ── Email (console backend by default in dev) ─────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=support@glavbox.com

OTP_EXPIRY_MINUTES=10

# Per-user/IP cap on contact-support submissions (DRF throttle rate) — the
# endpoint is AllowAny and accepts file uploads, so it needs its own limit.
SUPPORT_REQUEST_THROTTLE=5/hour

# ── Rate limits (DRF throttle rates) ──────────────────────────────────────
# Baseline ceiling applied to every route.
ANON_THROTTLE=60/min
USER_THROTTLE=240/min
# The auth endpoints are AllowAny and cheap to script against, so they get
# tighter, purpose-built limits. Login/register key on client IP; the two OTP
# scopes key on the target email, so a distributed attacker can't grind one
# account from a pool of addresses.
AUTH_LOGIN_THROTTLE=10/min
AUTH_REGISTER_THROTTLE=10/hour
AUTH_VERIFY_OTP_THROTTLE=10/hour
AUTH_RESEND_OTP_THROTTLE=5/hour

# ── Transport security ────────────────────────────────────────────────────
# All of these default to "on unless DEBUG", so they need no values in a
# deployed environment. Set them only to override, e.g. to disable HSTS while
# testing against a plain-HTTP host.
# SECURE_SSL_REDIRECT=
# SESSION_COOKIE_SECURE=
# CSRF_COOKIE_SECURE=
# SECURE_HSTS_SECONDS=
# SECURE_HSTS_INCLUDE_SUBDOMAINS=
# Preload is opt-in — submitting to the browser preload list is hard to undo.
# SECURE_HSTS_PRELOAD=False

# CA bundle for a rediss:// Celery broker with a private CA (Memorystore).
# Certificates are verified either way; leave blank for a public CA.
# CELERY_BROKER_SSL_CA_CERTS=

# ── AI assistant (Gemini) ───────────────────────────────────────────────────
# Google AI Studio API key — powers the in-app car assistant chat.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Per-user cap on assistant message sends (DRF throttle rate).
ASSISTANT_CHAT_THROTTLE=30/min

# ── Frontend ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8001/api/v1
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
FRONTEND_URL=http://localhost:3000

# Cloudinary (car photo uploads — browser uploads directly to Cloudinary via
# an unsigned upload preset; the API never sees the file)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# TelemetryDeck (privacy-focused product analytics) — App ID from the
# TelemetryDeck dashboard. Leave blank to disable telemetry entirely.
NEXT_PUBLIC_TELEMETRYDECK_APP_ID=

# What "what version is this" shows (GET /health/, Settings page footer) —
# see #74. The deploy workflow sets both to the release tag for prod,
# "dev-<short sha>" for dev; unset/"dev" locally.
APP_VERSION=
NEXT_PUBLIC_APP_VERSION=
